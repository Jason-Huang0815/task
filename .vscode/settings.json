{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/host/compile_commands.json",
  "files.encoding": "utf8",
  "files.eol": "\n",
  "editor.formatOnSave": false,
  "files.associations": {
    "*.h": "cpp"
  },
  "search.exclude": {
    "**/build": true,
    "**/.git": true
  }
}
