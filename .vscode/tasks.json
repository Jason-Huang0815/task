{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "host: configure",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "host-debug"],
      "problemMatcher": []
    },
    {
      "label": "host: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "host-debug", "--parallel"],
      "dependsOn": "host: configure",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "host: test",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "host-debug", "--output-on-failure"],
      "dependsOn": "host: build",
      "problemMatcher": []
    },
    {
      "label": "idf: build",
      "type": "shell",
      "command": "idf.py",
      "args": ["-B", "build/idf", "build"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "idf: flash",
      "type": "shell",
      "command": "idf.py",
      "args": ["-B", "build/idf", "-p", "${input:comPort}", "flash"],
      "problemMatcher": []
    },
    {
      "label": "idf: monitor",
      "type": "shell",
      "command": "idf.py",
      "args": ["-B", "build/idf", "-p", "${input:comPort}", "monitor"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "comPort",
      "type": "promptString",
      "description": "串口（如 COM5）",
      "default": "COM5"
    }
  ]
}
