# 目标芯片与 Flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# N16R8 模组：8 MB Octal PSRAM，用于 LVGL 字体与绘制缓冲
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 自定义分区：双 OTA + LittleFS（见 partitions.csv）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 1 kHz tick：50 Hz 采样与 1 s UI 节流的调度基础
CONFIG_FREERTOS_HZ=1000

# 任务看门狗 8 s（文档 4.10）
CONFIG_ESP_TASK_WDT_TIMEOUT_S=8

CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# LVGL 与界面（角色 E：hb_ui / hb_app）
# 16 位色：与 ATK-MD0430R RGB565 面板一致，32 位会花屏且帧缓冲翻倍
CONFIG_LV_COLOR_DEPTH_16=y
# 内置 Montserrat 字库：中文子集未生成前的降级路径，48 px 供表盘数字使用
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 帧率/CPU 角标与 LVGL 日志：M0 起调试用，发布前可关
# PERF_MONITOR 依赖 SYSMON，少一个都不会生效
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
# 240 MHz 主频：40 帧 800x480 刷新的前提
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
